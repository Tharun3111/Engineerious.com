# ---------------------------------------------------------------------------
# Engineerious — environment
# Copy to .env.local for development. Set the same keys in the Vercel project.
# ---------------------------------------------------------------------------

# === REQUIRED ==============================================================

# Neon serverless Postgres. Use the pooled connection string.
# https://console.neon.tech → project → Connection Details
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/engineerious?sslmode=require"

# Shared secret for /api/cron/*. Vercel Cron sends it as `Authorization: Bearer`.
# Generate: openssl rand -hex 32
# Cron routes FAIL CLOSED if this is unset.
CRON_SECRET=""

# HTTP Basic password for /admin and /api/admin (username is ignored).
# /admin returns 503 if this is unset — it is never open.
ADMIN_PASSWORD=""

# HMAC key for durable /api/subscribe and /api/submit rate-limit identities.
# Generate exactly once per environment: openssl rand -hex 32
# Keep it stable across instances. Production/Vercel mutations FAIL CLOSED if it
# is missing, not valid 32-128-byte hex, or migration 0010 has not been applied.
# Raw client addresses and email addresses are never stored in the counter table.
PUBLIC_MUTATION_RATE_LIMIT_SECRET=""

# Canonical origin. Used for canonical URLs, sitemap, RSS, and repurposed links.
NEXT_PUBLIC_SITE_URL="https://engineerious.com"

# Contact email shown in the footer. Optional — the "Contact" link just doesn't render
# without it.
NEXT_PUBLIC_CONTACT_EMAIL="tharun@engineerious.com"

# Social profile URLs. Each icon in the nav/footer renders only when its URL is set —
# leave unset until the account exists rather than linking a placeholder.
NEXT_PUBLIC_TWITTER_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_LINKEDIN_URL=""
# The site says "built in public" — this is the link that makes that true. For an AI
# engineering audience a repo is the load-bearing credential; without it the claim is
# unsupported. https://github.com/Tharun3111/Engineerious.com
NEXT_PUBLIC_GITHUB_URL=""

# Launch gate. "false" (default) closes /open-source, /submit, and /pillars —
# 404 with noindex. /news, /models, and placeholder /resources stay closed in
# both states. See lib/public-launch.ts and docs/launch-runbook.md.
PUBLIC_RESEARCH_ENABLED="false"


# === SEO (all optional) =====================================================

# Site-ownership verification tokens. Paste the raw token Google Search Console /
# Bing Webmaster Tools gives you when adding the property as a "meta tag" method —
# not the full <meta> tag. Rendered in app/layout.tsx; unset = no tag, not a broken
# one. These bake into the static homepage at build time — changing them needs a
# redeploy, not just a Vercel env update.
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""

# IndexNow key (Bing/Yandex instant-indexing ping on publish — see lib/indexnow.ts).
# Generate: openssl rand -hex 16
# The same value must also exist as a static file at public/<key>.txt containing
# just the key, or Bing's key-location check fails.
INDEXNOW_KEY=""


# === INGESTION (all optional; the site launches on free sources alone) =====

# GitHub personal access token — no scopes needed for public search.
# Without it: 10 search req/min instead of 30, and you will hit the limit.
GITHUB_TOKEN=""

# Hugging Face token. Optional — the Hub endpoints used here are public.
HF_TOKEN=""

# Product Hunt developer token.
# ⚠️ Product Hunt's API terms are NON-COMMERCIAL. Confirm your use is acceptable
# or leave this unset; the adapter is skipped when it is empty.
PRODUCTHUNT_TOKEN=""

# Commercial news API. Only these three are wired up, because only these three
# permit commercial use on their free tier:
#   newsdata | currents | apitube
# ⚠️ Do NOT use NewsAPI.org (free tier is development-only) or GNews (free tier
# prohibits commercial use).
NEWS_API_PROVIDER=""
NEWS_API_KEY=""

# Review-first by default. Omitted or "true" means new rows stay pending until
# approved in /admin. Set "false" only for private local fixtures.
INGEST_REQUIRE_APPROVAL="true"

# Daily Brief pipeline. /api/cron/daily-digest performs GATHER + RESEARCH;
# /api/cron/daily-write creates a private structured draft and automated review.
# Neither route publishes. A human must edit, write + confirm My Take, and publish
# the exact reviewed revision from /admin.
#   Tavily: free tier, 1,000 credits/month, no card — tavily.com
#   Finnhub: free tier, ~60 req/min — finnhub.io
#   Twelve Data: free tier, 800 req/day — twelvedata.com
# Without these, the daily-digest cron returns errors rather than partial/fake data —
# it is not designed to run gracefully degraded like the feed adapters are.
TAVILY_API_KEY=""
FINNHUB_API_KEY=""
TWELVEDATA_API_KEY=""


# === REPURPOSING & DISTRIBUTION (optional) =================================

# LLM for repurposing drafts and Daily research/write/review stages.
# Anthropic is preferred; OpenAI is the fallback if ANTHROPIC_API_KEY is unset.
ANTHROPIC_API_KEY=""
LLM_MODEL="claude-sonnet-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1"

# Buffer — the default publisher. Requires a paid plan and one connected channel
# per platform. Approvals fall back to a no-op dry run when unset.
BUFFER_TOKEN=""
BUFFER_CHANNEL_LINKEDIN=""
BUFFER_CHANNEL_X=""
BUFFER_CHANNEL_INSTAGRAM=""
BUFFER_CHANNEL_YOUTUBE=""
BUFFER_CHANNEL_FACEBOOK=""

# Ayrshare — alternate publisher (13+ platforms, one endpoint). Used only if
# BUFFER_TOKEN is unset.
AYRSHARE_API_KEY=""


# === NEWSLETTER (optional) =================================================

# Resend — contact sync and optional transactional/broadcast delivery. Postgres is
# the subscriber source of truth, so /api/subscribe still saves valid signups when
# these are absent or temporarily unavailable. Web publication never sends a
# broadcast; newsletter sends require their own manual approval.
#   1. Sign up at resend.com (no card required for the free tier).
#   2. Create ONE Segment in the Resend dashboard (Audiences → Segments → New) —
#      e.g. "Newsletter" — and paste its id below. Every subscriber is added to it;
#      every daily-digest send targets it.
#   3. Verify your sending domain (SPF/DKIM/DMARC) in Resend before going live, or
#      mail lands in spam.
RESEND_API_KEY=""
RESEND_SEGMENT_ID=""
RESEND_FROM_ADDRESS="Engineerious <digest@engineerious.com>"
# A valid physical postal address rendered in every newsletter broadcast.
# Delivery fails closed when this is empty; use a registered PO box if preferred.
NEWSLETTER_POSTAL_ADDRESS=""

# Optional passive fallback: if set, /subscribe also renders a beehiiv embed iframe.
# beehiiv is NOT used for sending (its Send API requires a ~$96/mo plan regardless
# of subscriber count) — Resend above is the actual delivery path.
NEXT_PUBLIC_BEEHIIV_EMBED_URL=""
