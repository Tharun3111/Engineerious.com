{
  "name": "engineerious",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "@eslint/eslintrc": {
      "js-yaml": "4.3.2"
    },
    "gray-matter": {
      "js-yaml": "3.15.2"
    }
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:production": "npm run build && PLAYWRIGHT_PRODUCTION=true playwright test",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "cron:news": "node scripts/run-cron.mjs news",
    "cron:models": "node scripts/run-cron.mjs models",
    "cron:oss": "node scripts/run-cron.mjs oss",
    "cron:rank": "node scripts/run-cron.mjs rank",
    "cron:daily-digest": "node scripts/run-cron.mjs daily-digest",
    "cron:daily-write": "node scripts/run-cron.mjs daily-write",
    "cron:all": "node scripts/run-cron.mjs all",
    "qa:smoke": "node scripts/qa-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "2.0.1",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "mermaid": "^11.16.1",
    "next": "^16.3.6",
    "next-mdx-remote": "^6.0.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rss-parser": "^3.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
